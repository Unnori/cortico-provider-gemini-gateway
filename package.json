{
  "name": "cortico-provider-gemini-gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico provider for Gemini Robin desktop OAuth multi-account pools, Web2API Gemini REST, and custom session RPC gateways.",
  "author": "云纪&云洄",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unnori/cortico-provider-gemini-gateway.git"
  },
  "homepage": "https://github.com/Unnori/cortico-provider-gemini-gateway#readme",
  "bugs": {
    "url": "https://github.com/Unnori/cortico-provider-gemini-gateway/issues"
  },
  "keywords": [
    "cortico-provider",
    "cortico",
    "gemini",
    "robin",
    "oauth"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.8",
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "cortico": {
    "kind": "provider",
    "api": 6,
    "displayName": "Custom Gemini Gateway",
    "locales": {
      "zh": {
        "displayName": "Gemini 多协议网关 (Robin / Web2API / RPC)",
        "description": "支持 Robin 桌面 OAuth 多账号调度、Web2API 原生 Gemini 与自定义会话式 RPC 网关，内置额度监控与自动计价。"
      },
      "en": {
        "displayName": "Custom Gemini Gateway (Robin / Web2API / RPC)",
        "description": "Gemini Robin desktop OAuth multi-account pool, Web2API Gemini REST, and custom session RPC gateway with quota tracking and pricing."
      }
    },
    "tags": [
      "experimental",
      "unofficial-api"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "resources",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:webui": "esbuild src/webui/client.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/webui.js && node -e \"import('node:fs').then(f=>f.copyFileSync('src/webui/style.css','dist/webui.css'))\"",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm build:webui && pnpm typecheck && pnpm typecheck:web && pnpm test",
    "prepublishOnly": "pnpm verify",
    "login": "node --experimental-strip-types src/login.ts",
    "test:robin": "node --experimental-strip-types scripts/run-robin-test.ts",
    "verify:robin": "node --experimental-strip-types scripts/verify-robin.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.17",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
